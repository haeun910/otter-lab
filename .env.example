# .env.local로 복사해서 채워 주세요 (내 컴퓨터에서 npm run dev 할 때). 진짜 키는 이 파일(.env.example)에 넣지 마세요.
# 자세한 순서는 SETUP.md

# 글 쓰는 AI. 없으면 소식 요약으로 뼈대 초안을 만들어요.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Supabase (둘 다 비우면 로그인 없이 이 브라우저에만 저장해요)
NEXT_PUBLIC_SUPABASE_URL=
# sb_publishable_로 시작하는 키 (예전 프로젝트면 대신 NEXT_PUBLIC_SUPABASE_ANON_KEY에 anon 키)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 구글 로그인을 켰으면 1
NEXT_PUBLIC_LOGIN_GOOGLE=

# ↓ 자동 회의 스크립트(npm run daily)를 내 컴퓨터에서 돌려 볼 때만. Vercel에는 넣지 마세요.
# sb_secret_로 시작하는 키 (예전 프로젝트면 service_role 키)
SUPABASE_SECRET_KEY=
# 알림은 디스코드·텔레그램 중 하나만 채워도 돼요
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LAB_URL=
