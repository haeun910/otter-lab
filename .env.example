# .env.local로 복사해서 채워 주세요 (내 컴퓨터에서 npm run dev 할 때). 진짜 키는 이 파일(.env.example)에 넣지 마세요.
# 자세한 순서는 SETUP.md

# 글 쓰는 AI. 없으면 소식 요약으로 뼈대 초안을 만들어요.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Supabase (둘 다 비우면 로그인 없이 이 브라우저에만 저장해요)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 구글 로그인을 켰으면 1
NEXT_PUBLIC_LOGIN_GOOGLE=

# ↓ 자동 회의 스크립트(npm run daily)를 내 컴퓨터에서 돌려 볼 때만. Vercel에는 넣지 마세요.
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LAB_URL=
